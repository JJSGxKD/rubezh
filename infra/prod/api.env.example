# Переменные API прода — файл /srv/rubezh/app/api.env, права 600. Смысл
# каждой — в корневом .env.example, здесь только то, чем прод отличается от
# умолчаний (docs/20-env-and-ports.md §5.3). Секреты пусты: они генерируются
# на сервере или приходят от владельца, в репозиторий не попадают.

NODE_ENV=production
API_PORT=4000
API_HOST=0.0.0.0

# База и Redis — по именам сервисов compose; пароль — тот же, что в .env.
DATABASE_URL=postgresql://rubezh:<пароль>@postgres:5432/rubezh?schema=public
REDIS_URL=redis://redis:6379/0

# Перед API ровно один прокси — Caddy: адрес игрока берётся из него.
TRUST_PROXY_HOPS=1
ALLOWED_ORIGINS=https://tg.gonet.fun,https://admin.gonet.fun,https://gonet.fun
PUBLIC_API_URL=https://api.gonet.fun
PUBLIC_WEB_URL=https://tg.gonet.fun

TELEGRAM_BOT_TOKEN=
# Из российской сети api.telegram.org недоступен: Bot API — через прокси
# tgrasp.ru (Graspil), решение участника 1 от 26.09.2026.
TELEGRAM_API_ROOT=https://tgrasp.ru
# Входящие соединения серверов Telegram до сервера тоже не доходят, поэтому
# вебхук не работает: бот забирает обновления сам, long polling'ом через тот
# же прокси. Читатель один — его держит лок в Redis.
TELEGRAM_BOT_UPDATES=polling
# Секрет вебхука остаётся заданным: вернуться на вебхук — смена одной строки.
TELEGRAM_WEBHOOK_SECRET=

ADMIN_TELEGRAM_IDS=
ADMIN_CHAT_ID=
ADMIN_CHAT_STATS=
ADMIN_CHAT_STRESS=
ADMIN_CHAT_RUNS=
ADMIN_CHAT_FEEDBACK=
ADMIN_CHAT_RUN_REVIEW=
ADMIN_NOTIFY_REPORTS=true
ADMIN_PANEL_ENABLED=true

AUTH_ENABLED=true
JWT_ACCESS_SECRET=
AUTH_DEV_LOGIN=false

EVENTS_INGEST_ENABLED=true
DIAGNOSTICS_INGEST_ENABLED=true
EXPORT_PSEUDONYM_KEY=
DATA_EXPORT_BOT_ENABLED=true

# Оплата звёздами — выключена до решения владельца; при включении
# PAYMENTS_TEST_MODE остаётся false: вне разработки оплата настоящая.
PAYMENTS_ENABLED=false

# Курсы — после установки заданных курсов звезды (fx:manual, Р37).
FX_ENABLED=false
