# Край прода (docs/09-ci-cd.md §10, docs/20-env-and-ports.md §2.1).
#
# Сертификаты — DNS-проверкой через Bunny: зона домена там, и так они
# выпускаются и за CDN. Статика лежит каталогами версий в /srv/web/<app>/,
# `current` — ссылка на выкаченную; откат — переключение ссылки.
#
# Политика источников (CSP) клиента и панели — не здесь: её кладёт сборка
# файлом `csp.txt`, а deploy.sh делает из него сниппет edge/<app>.caddy.
# Своя строка политики здесь была бы второй копией, которая однажды
# разойдётся с проверенной под забегом.

# Почта ACME не задаётся: Caddy продлевает сертификаты сам, а письма об
# истечении нам не нужны.
#
# Клиент и лендинг — за CDN Bunny (docs/20-env-and-ports.md §2.2): к Caddy
# приходит узел CDN, а адрес игрока — в X-Forwarded-For. Верим этому
# заголовку только от узлов Bunny — их список edge-ips.sh кладёт в
# edge/trusted-proxies.caddy и обновляет раз в сутки. Разбор справа налево
# (strict): левые значения заголовка дописал сам клиент, а правое — узел CDN.
# Без списка (первый запуск) адрес — узел CDN: лимиты частоты общие на узел,
# но поддельный заголовок не проходит.
{
	acme_dns bunny {env.BUNNY_API_KEY}
	servers {
		import edge/trusted-proxies*.caddy
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

# До API — адрес игрока одним значением: API верит ровно одному прокси
# (TRUST_PROXY_HOPS=1), и цепочка «игрок, узел CDN» дала бы ему узел CDN —
# все игроки за узлом попали бы в один лимит частоты. Ответ без своего
# Cache-Control CDN не кэширует: no-store по умолчанию, а то, что API
# разрешает кэшировать (картинки по неизменному адресу), он помечает сам.
(api) {
	header ?Cache-Control "no-store"
	reverse_proxy api:4000 {
		header_up X-Forwarded-For {client_ip}
	}
}

(edge) {
	encode zstd gzip
	header {
		# HSTS — только на краю: TLS завершается здесь, и API не знает протокол.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	log {
		output stdout
		format json
	}
}

# Одностраничное приложение из каталога версий. Файлы сборки с хэшем в имени
# кэшируются навсегда, всё остальное — никогда: index.html, точка входа
# предпросмотра для панели (`preview/`, своя сборка в той же статике) и любой
# путь, на который отвечает index.html. Иначе CDN держал бы старую точку
# входа, а она ссылается на файлы удалённой версии — белый экран.
# Нет файла с хэшем — 404, а не index.html: страница под адресом скрипта
# закэшировалась бы навсегда.
(spa) {
	root * /srv/web/{args[0]}/current
	# csp.txt — служебный: политика и так уходит заголовком.
	handle /csp.txt {
		respond 404
	}
	@hashed path /assets/* /preview/assets/*
	handle @hashed {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Лендинг — пока заглушка: сам лендинг — задача О7 (docs/36-parallel-work.md).
{$DOMAIN} {
	import edge
	handle /r/* {
		import api
	}
	handle {
		import spa landing
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Клиент Telegram. API — на своём же домене: без CORS, и сборке не нужен
# адрес прода. Префикс панели сюда не пускается — у неё свой домен и
# cookie-сессия.
tg.{$DOMAIN} {
	import edge
	import edge/web-telegram*.caddy
	# Без слэша try_files отдал бы саму игру — и панель запустила бы её во фрейме.
	redir /preview /preview/ permanent
	handle /api/v1/admin/* {
		respond 404
	}
	handle /api/* {
		import api
	}
	handle /r/* {
		import api
	}
	handle {
		import spa web-telegram
	}
}

# Панель: API только своим префиксом — как у dev-сервера панели.
admin.{$DOMAIN} {
	import edge
	import edge/admin*.caddy
	header X-Frame-Options DENY
	handle /api/v1/admin/* {
		import api
	}
	handle /api/* {
		respond 404
	}
	handle {
		import spa admin
	}
}

# API снаружи — вебхук бота и то, что ходит не со страниц клиента.
# Префикс панели сюда не пускается — у неё свой домен и cookie-сессия.
api.{$DOMAIN} {
	import edge
	handle /api/v1/admin/* {
		respond 404
	}
	handle {
		import api
	}
}

# Веб и гостевая — WP18; до неё адрес ведёт на лендинг.
play.{$DOMAIN} {
	redir https://{$DOMAIN} temporary
}

# Управляющее соединение туннелей: frpc ходит сюда по WebSocket.
frp.{$DOMAIN} {
	reverse_proxy frps:7000
}

# Dev-серверы разработчиков через туннели. Host сохраняется — по нему frps
# выбирает, чей туннель.
tg.dev.{$DOMAIN}, max.dev.{$DOMAIN}, vk.dev.{$DOMAIN}, admin.dev.{$DOMAIN} {
	reverse_proxy frps:8080
}
