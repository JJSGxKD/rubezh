# Переменные compose прода — файл /srv/rubezh/app/.env, права 600.
# Секреты пусты намеренно: у секретов не бывает значений по умолчанию
# (docs/20-env-and-ports.md §1). Переменные самого API — в api.env.

# Корень доменов (docs/20-env-and-ports.md §2.1).
DOMAIN=gonet.fun
# Ключ API Bunny для DNS-проверки сертификатов — у Caddy и больше ни у кого.
BUNNY_API_KEY=

# Выкаченная версия образа API — её переписывает deploy.sh.
API_TAG=

POSTGRES_USER=rubezh
POSTGRES_PASSWORD=
POSTGRES_DB=rubezh

# Токен туннелей разработчиков: тот же — в infra/frpc/frpc.local.toml у разработчика.
FRP_TOKEN=

# Кому бот шлёт зашифрованный бэкап — Telegram ID владельца (backup.sh).
BACKUP_CHAT_ID=
