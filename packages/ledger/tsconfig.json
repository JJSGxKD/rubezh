{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Как у ядра курсов: ESM с NodeNext и без DOM — ядро учёта живёт в
    // сервисе и переходит в другие проекты (docs/35-stage4-plan.md, Р98).
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}
