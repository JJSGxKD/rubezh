{
  "log": {
    "loglevel": "warning",
    "access": "none"
  },
  "inbounds": [
    {
      "tag": "in-0",
      "listen": "127.0.0.1",
      "port": 10800,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": false
      }
    }
  ],
  "outbounds": [
    {
      "tag": "block",
      "protocol": "blackhole"
    },
    {
      "tag": "out-{{KEY}}",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "example.com",
            "port": 443,
            "users": [
              {
                "id": "11111111-1111-4111-8111-111111111111",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": {
          "serverName": "cdn.example.com",
          "alpn": [
            "h2",
            "http/1.1"
          ],
          "fingerprint": "firefox"
        },
        "wsSettings": {
          "path": "/ws",
          "headers": {
            "Host": "cdn.example.com"
          }
        }
      },
      "mux": {
        "enabled": false
      }
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "inboundTag": [
          "in-0"
        ],
        "outboundTag": "out-{{KEY}}"
      }
    ]
  }
}
