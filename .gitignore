node_modules/
dist/
*.tsbuildinfo
build/
.env
.env.*
!.env.example
*.log
.DS_Store
.turbo/
coverage/

# Локальные данные: отчёты FPS-испытаний и прочее рантайм-состояние
var/
# Клиент Prisma генерируется из схемы и в git не хранится
backend/api/src/generated/
.obsidian/

# Рабочий конфиг frpc: содержит токен туннеля
infra/frpc/frpc.local.toml

# Сертификаты разработки: закрытый ключ не коммитится, даже локальный
infra/certs/

# Снимок Redis, запущенного из каталога пакета: данные тестов, не исходники
*.rdb

# Локальные настройки Claude Code: запуск dev-серверов с тестовыми ключами,
# личные разрешения и рабочие копии исполнителей
.claude/launch.json
.claude/settings.local.json
.claude/worktrees/

# Кадры и промо дизайнера пересобираются скриптами design/art/src и живут в
# галерее, а не в git (решение владельца 24.10.2026, docs/35 Р143); в git —
# только кадры, на которые ссылается макет ui-fixes.html
design/art/out/preview/*
!design/art/out/preview/ui-*.png
design/art/out/promo/
# Черновые WAV музыки: в git — только OGG и M4A в packages/app-shell/src/audio/music.
design/art/out/music/
