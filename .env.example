# =============================================================================
# Шаблон переменных окружения. Скопировать в `.env` и заполнить.
#
# Полное описание каждой группы, карта портов и различия dev/staging/prod —
# в docs/20-env-and-ports.md. Правила работы с секретами —
# docs/15-engineering-standards.md §9 и docs/09-ci-cd.md §3.
#
# ПРАВИЛА:
#  * `.env` НИКОГДА не коммитится (см. .gitignore). Здесь — только пустые
#    значения и безопасные дефолты для локальной разработки.
#  * У секретов не бывает дефолтов. Приложение падает при старте, если
#    обязательная переменная не задана, — это осознанное поведение.
#  * Всё, что начинается с `VITE_`, попадает в клиентский бандл и является
#    ПУБЛИЧНЫМ. Секреты туда класть нельзя, независимо от названия.
#  * У staging и production — отдельные наборы значений и отдельный бот.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Окружение
# -----------------------------------------------------------------------------
# development | staging | production
NODE_ENV="development"

# Платформа текущей сборки: telegram | max | vk | web
# В dev задаётся флагом `--mode` у Vite, здесь — для бэкенда и скриптов.
APP_PLATFORM="telegram"

# Версия приложения. Попадает в логи и крэш-репорты — без неё невозможно
# понять, с какой версии клиента пришёл баг-репорт, а из-за модерации
# площадок одновременно живут несколько версий (docs/09-ci-cd.md §8).
APP_VERSION="0.1.0"


# -----------------------------------------------------------------------------
# 2. Порты. Полная карта и обоснование — docs/20-env-and-ports.md §2
#
# В production порты БД, Redis и Prometheus НЕ публикуются наружу — наружу
# смотрит только Caddy (80/443). Значения ниже — для локальной разработки.
# -----------------------------------------------------------------------------

# --- Бэкенд ---
API_PORT="4000"
API_HOST="0.0.0.0"

# --- Dev-серверы Vite (каждая платформа на своём порту, чтобы можно было
#     запустить несколько одновременно) ---
WEB_TELEGRAM_PORT="5173"
WEB_MAX_PORT="5174"
WEB_VK_PORT="5175"

# --- Админка геймдизайнера (docs/19-content-admin.md) ---
ADMIN_PORT="5176"

# --- Кабинет партнёра (docs/23-referral-and-partner-program.md §4.4) ---
PARTNER_CABINET_PORT="5177"

# --- Инфраструктура ---
POSTGRES_PORT="5432"
REDIS_PORT="6379"
PROMETHEUS_PORT="9090"
GRAFANA_PORT="3001"

# --- Caddy (только staging/production) ---
HTTP_PORT="80"
HTTPS_PORT="443"


# -----------------------------------------------------------------------------
# 3. База данных
# -----------------------------------------------------------------------------
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="bullet_heaven"
POSTGRES_HOST="localhost"

# Prisma собирает строку подключения из значений выше. В проде — тот же
# формат, но host = имя сервиса в docker-compose, а не localhost.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bullet_heaven?schema=public"


# -----------------------------------------------------------------------------
# 4. Redis — кеш, распределённые локи, лидерборды (ZSET), очереди BullMQ
# -----------------------------------------------------------------------------
REDIS_HOST="localhost"
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379"


# -----------------------------------------------------------------------------
# 5. Авторизация и сессии
#
# Секреты генерировать так: openssl rand -hex 32
# Разные значения для access и refresh — обязательно.
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="30d"

# Окно свежести initData. Держать коротким: это защита от повторного
# использования перехваченных данных запуска (docs/13-reuse-from-vpnsibcom.md §2.1 F).
INIT_DATA_EXPIRES_IN="60s"

COOKIE_SECRET=""
COOKIE_DOMAIN="localhost"
COOKIE_SECURE="false"


# -----------------------------------------------------------------------------
# 6. CORS и публичные адреса
# -----------------------------------------------------------------------------
# Список через запятую, без пробелов. В проде — только реальные домены
# мини-приложений, никаких '*'.
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176"

PUBLIC_API_URL="http://localhost:4000"
PUBLIC_WEB_URL="http://localhost:5173"
PUBLIC_CDN_URL=""


# -----------------------------------------------------------------------------
# 7. Авторизация по платформам (docs/01-tech-stack.md §4)
#
# ВАЖНО: для staging — отдельный тестовый бот. Общий бот между окружениями
# означает, что тестовая рассылка уходит реальным игрокам.
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# Схема валидации MAX Bridge на момент написания не сверена с документацией —
# открытый вопрос, docs/03-notes-and-risks.md
MAX_BRIDGE_SECRET=""
MAX_APP_ID=""

VK_APP_ID=""
VK_APP_SECRET=""

# Веб-версия: RU-контур и международный — разные наборы в одном билде
# (docs/08-web-and-identity.md §1, docs/09-ci-cd.md §3)
YANDEX_ID_CLIENT_ID=""
YANDEX_ID_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# -----------------------------------------------------------------------------
# 8. Платежи (docs/01-tech-stack.md §5)
#
# В Telegram Mini App цифровые товары продаются ТОЛЬКО за Stars —
# инвойс создаётся на бэкенде токеном бота, отдельный ключ не нужен.
# Цены задаются в админке и являются серверной величиной (docs/19-content-admin.md).
# -----------------------------------------------------------------------------
PAYMENTS_WEBHOOK_SECRET=""

# RU-эквайринг для MAX и веб-версии — подключается на этапе портирования
RU_ACQUIRING_SHOP_ID=""
RU_ACQUIRING_API_KEY=""


# -----------------------------------------------------------------------------
# 9. Реклама (docs/07-monetization-and-ads.md)
#
# Порядок и активность сетей задаются данными в БД (priority/isActive),
# здесь только ключи доступа.
# -----------------------------------------------------------------------------
ADS_SESSION_SECRET=""
ADSGRAM_BLOCK_ID=""
ADSGRAM_API_KEY=""
TADDY_PUB_KEY=""
TADDY_SECRET_KEY=""
RICHADS_PUB_KEY=""
SOCIALLEAD_API_KEY=""
VK_ADS_APP_ID=""


# -----------------------------------------------------------------------------
# 10. Наблюдаемость (docs/14-scalability.md §6)
#
# Алерты уходят в тред Telegram-супергруппы: для команды из трёх человек без
# дежурств это единственный канал. В тред идут только warn и error.
# -----------------------------------------------------------------------------
LOG_LEVEL="debug"
TELEGRAM_LOG_CHAT_ID=""
TELEGRAM_THREAD_ID_WARN=""
TELEGRAM_THREAD_ID_ERROR=""
TELEGRAM_THREAD_ID_PAYMENTS=""
TELEGRAM_THREAD_ID_BACKUPS=""

SENTRY_DSN=""
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD=""


# -----------------------------------------------------------------------------
# 11. Админка геймдизайнера (docs/19-content-admin.md)
# -----------------------------------------------------------------------------
# Telegram ID тех, кому разрешён вход, через запятую. Роль проверяется ещё и
# в БД — это второй рубеж, а не единственный.
ADMIN_TELEGRAM_IDS=""
ADMIN_SESSION_SECRET=""

# Обязательное подтверждение golden-прогоном перед публикацией конфигурации.
# Выключать только осознанно и временно.
CONTENT_PUBLISH_REQUIRE_SIMULATION="true"


# -----------------------------------------------------------------------------
# 12. Программы роста и аналитика
# (docs/22-analytics-and-metrics.md, docs/23-referral-and-partner-program.md,
#  docs/24-attribution-and-sharing.md)
# -----------------------------------------------------------------------------
# Домен редирект-страницы /r/:code. Отдельный короткий домен читается лучше
# в постах и историях, но допустим и основной.
REDIRECT_BASE_URL="http://localhost:4000"

# Срок жизни клика: дольше связь между кликом и запуском недостоверна.
CLICK_TTL_DAYS="30"

# Подпись ссылок шеринга и параметров карточки профиля.
SHARE_SIGNING_SECRET=""

# Кеш серверного рендера карточек, секунды. Рендер — самая дорогая операция
# в потоке шеринга, кеш обязателен.
SHARE_IMAGE_CACHE_TTL="86400"

# Отдельный пользователь Postgres только на чтение — под datasource Grafana.
# Grafana ходит в витрины на реплике, а не в горячие таблицы.
GRAFANA_PG_USER="grafana_ro"
GRAFANA_PG_PASSWORD=""

# Сколько суток хранить сырые IP и User-Agent до усечения и хэширования
# (персональные данные, docs/22-analytics-and-metrics.md §7).
ANALYTICS_RAW_PII_RETENTION_DAYS="90"


# -----------------------------------------------------------------------------
# 13. Публичные переменные клиента (попадают в бандл, НЕ секреты!)
# -----------------------------------------------------------------------------
VITE_API_URL="http://localhost:4000"
VITE_APP_VERSION="0.1.0"
VITE_SENTRY_DSN=""
VITE_TELEGRAM_BOT_USERNAME=""
