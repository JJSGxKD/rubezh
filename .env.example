# =============================================================================
# Шаблон переменных окружения. Скопировать в `.env` и заполнить.
#
# Здесь только то, что читает код сегодня: карта настроек —
# docs/30-configuration-map.md, подробности и планы — docs/20-env-and-ports.md.
# Переменная появляется здесь вместе со схемой конфигурации, которая её читает
# (docs/20-env-and-ports.md §7), и не раньше: файл с переменными «на будущее»
# перестаёт быть источником правды.
#
# ПРАВИЛА:
#  * `.env` НИКОГДА не коммитится (см. .gitignore). Здесь — только пустые
#    значения и безопасные дефолты для локальной разработки.
#  * У секретов не бывает дефолтов. Приложение падает при старте, если
#    обязательная переменная не задана, — это осознанное поведение.
#  * Всё, что начинается с `VITE_`, попадает в клиентский бандл и является
#    ПУБЛИЧНЫМ. Секреты туда класть нельзя, независимо от названия.
#  * У staging и production — отдельные наборы значений и отдельный бот.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Окружение и порты (docs/20-env-and-ports.md §2)
#
# Порт не выбирается на месте — берётся из карты портов. В production порты
# Postgres и Redis наружу не публикуются: наружу смотрит только Caddy.
# -----------------------------------------------------------------------------

# development | staging | production
NODE_ENV="development"

# Бэкенд
API_PORT="4000"
API_HOST="0.0.0.0"

# Dev-серверы Vite: каждая площадка на своём порту, чтобы запускать их разом
WEB_TELEGRAM_PORT="5173"
WEB_MAX_PORT="5174"
WEB_VK_PORT="5175"
# Панель команды apps/admin (docs/29-admin-panel.md §4)
ADMIN_PORT="5176"

# Контейнеры docker-compose.yml
POSTGRES_PORT="5432"
REDIS_PORT="6379"


# -----------------------------------------------------------------------------
# 2. Postgres и Redis
#
# Логин, пароль и база — для контейнера из docker-compose.yml; бэкенд ходит по
# DATABASE_URL и REDIS_URL. Миграции применяются отдельно:
# pnpm --filter backend-api prisma:deploy. Без них приёмники пишут в пустоту и
# жалуются в лог на каждой пачке.
# -----------------------------------------------------------------------------

POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="bullet_heaven"

# Пусто — бэкенд поднимется, но приёмники и выгрузка работать не будут
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bullet_heaven?schema=public"
REDIS_URL="redis://localhost:6379"


# -----------------------------------------------------------------------------
# 3. Адреса, CORS и туннель (docs/20-env-and-ports.md §4)
# -----------------------------------------------------------------------------

# Кому разрешено обращаться к API, через запятую. Пусто — проверки Origin нет
# вовсе (годится только для локальной разработки), «*» в проде запрещён.
# Адреса по HTTPS — для проверки в Telegram без туннеля (см. ниже).
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175,https://127.0.0.1:5173"

# Сколько доверенных прокси стоит перед API: от этого зависит, какой адрес
# считается адресом игрока в лимитах частоты. За Caddy — 1.
TRUST_PROXY_HOPS="0"

# Публичные адреса: API — для регистрации вебхука бота и начала адреса награды
# AdsGram, который создаёт панель; Mini App — для кнопки «Играть». Кнопка Mini
# App требует HTTPS; с http-адресом бот отдаёт ссылку на Mini App через себя.
PUBLIC_API_URL="http://localhost:4000"
PUBLIC_WEB_URL="http://localhost:5173"

# Домены туннеля для проверки с телефона (pnpm tunnel): dev-сервер пускает их
# и отдаёт по ним HMR.
DEV_TUNNEL_TELEGRAM_HOST=""
DEV_TUNNEL_MAX_HOST=""
DEV_TUNNEL_VK_HOST=""

# Сертификат разработки: Telegram открывает Mini App только по HTTPS и только
# с действительным сертификатом. С доверенным сертификатом на 127.0.0.1
# десктопный клиент открывает dev-сборку без туннеля вовсе. Пути — от корня
# монорепо или абсолютные; задаются ВМЕСТЕ, с половиной пары сервер не
# поднимется. Выпуск сертификата — docs/20-env-and-ports.md §4.
DEV_HTTPS_CERT=""
DEV_HTTPS_KEY=""

# Адрес, по которому dev-сборку открывают с телефона в той же сети. Задан —
# сервер начинает слушать сеть, а не только петлю. Это сознательное
# исключение: несобранная dev-сборка становится доступна всей локальной сети,
# поэтому не включать на чужом Wi-Fi (docs/34-stage3-plan.md, Р9.1).
DEV_LAN_HOST=""


# -----------------------------------------------------------------------------
# 4. Бот закрытого теста (docs/28-diagnostics.md §6.1)
#
# Тот же бот проверяет подпись initData и отвечает на команды. У staging —
# отдельный бот: два процесса на одном токене дерутся за обновления.
# -----------------------------------------------------------------------------

TELEGRAM_BOT_TOKEN=""

# Адрес Bot API. Пусто — облако Telegram (https://api.telegram.org). Свой
# адрес нужен, если бот ходит через локальный сервер Bot API: у него другой
# хост, а методы и пути те же. Пример: "http://127.0.0.1:8081"
TELEGRAM_API_ROOT=""

# Откуда бот берёт обновления: off | polling | webhook.
#  * off — бот молчит: /start, /help, /stats и выгрузка не отвечают;
#  * polling — для машины разработчика: адреса для вебхука у неё нет;
#  * webhook — для сервера, требует TELEGRAM_WEBHOOK_SECRET и PUBLIC_API_URL.
# Читатель обновлений должен быть один на токен.
TELEGRAM_BOT_UPDATES="off"

# Секретный токен вебхука: от 32 знаков A-Z, a-z, 0-9, _ и -. Генерировать:
# openssl rand -hex 32. Свой на окружение, без него режим webhook не стартует.
TELEGRAM_WEBHOOK_SECRET=""

# Имя бота для ссылок-приглашений в клиенте, без @
VITE_TELEGRAM_BOT_USERNAME=""

# Ключ проекта в аналитике Graspil (docs/22-analytics-and-metrics.md §9). Не
# секрет — он уходит в сборку клиента, — но в dev пустой: иначе локальные
# запуски смешались бы с игроками. В сборку CI — переменной репозитория
# GRASPIL_KEY.
VITE_GRASPIL_KEY=""


# -----------------------------------------------------------------------------
# 5. Администраторы и их чаты (docs/20-env-and-ports.md §3)
#
# Адрес чата — id (у супергруппы с минусом) или "id:тема" для супергруппы с
# темами, например "-1001234567890:57". ADMIN_CHAT_ID — общий адрес, остальные
# переопределяют его для своего потока, пустые берут общий.
#
# Адреса чатов и ADMIN_NOTIFY_REPORTS — запасные значения: раздел «Настройки»
# в панели сильнее и меняет их без перезапуска (docs/20-env-and-ports.md §7).
# -----------------------------------------------------------------------------

# Telegram ID администраторов через запятую. Это АВАРИЙНЫЙ ПУТЬ, а не
# постоянный доступ: список даёт роль владельца, только пока в системе нет ни
# одного владельца. Как появился — доступ раздаётся ролями, а список молчит
# (docs/34-stage3-plan.md, WP2). Список не секрет, но мусор в нём — процесс не
# поднимается.
ADMIN_TELEGRAM_IDS=""

# Общий адрес: меню команд администратора и всё, у чего нет своего потока
ADMIN_CHAT_ID=""
# Сводка плейтеста и ответы на /stats
ADMIN_CHAT_STATS=""
# Карточки стресс-тестов
ADMIN_CHAT_STRESS=""
# Карточки проблемных забегов
ADMIN_CHAT_RUNS=""
# Отзывы игроков с формы обратной связи
ADMIN_CHAT_FEEDBACK=""
# Забеги на разбор антифрода: подозрительные и отклонённые, не чаще карточки в
# час на аккаунт. Работает при включённом входе (JWT_ACCESS_SECRET)
ADMIN_CHAT_RUN_REVIEW=""

# Карточки в чат администраторов на новые отчёты диагностики
# (docs/28-diagnostics.md §6.2). Работают при заданном адресе чата и включённом
# приёме отчётов; "false" — только в базу, без чата.
ADMIN_NOTIFY_REPORTS="true"

# Серверная часть админ-панели под /api/v1/admin/* (docs/35-stage4-plan.md,
# WP17): своя cookie-сессия, вход разработчика при AUTH_DEV_LOGIN, вход через
# виджет Telegram — когда появится домен. Работает вместе со входом
# (JWT_ACCESS_SECRET): панель живёт на аккаунтах и ролях, без роли в неё не
# пускают. Своего выключателя нет — выключенную из самой панели включить было
# бы неоткуда.

# Срок жизни сессии панели в минутах, 5–1440, без продления по активности.
ADMIN_SESSION_TTL_MIN="480"


# -----------------------------------------------------------------------------
# 6. Приём данных закрытого теста (docs/28-diagnostics.md §5)
#
# Оба приёмника пишут в Postgres: включённый приёмник без DATABASE_URL не
# стартует. Выключенный отвечает 404 — это выключатель на случай, когда в
# приёме что-то пошло не так, без релиза. Переменные — запасные значения
# настроек ingest.events и ingest.reports: раздел «Настройки» в панели сильнее
# и выключает приём на ходу (docs/20-env-and-ports.md §7).
# -----------------------------------------------------------------------------

EVENTS_INGEST_ENABLED="false"
DIAGNOSTICS_INGEST_ENABLED="false"

# Окно свежести подписи initData на приёме, секунды. Сутки: тестер играет
# часами после запуска, а в ответ на подпись сервер ничего не выдаёт.
INGEST_INIT_DATA_MAX_AGE_SEC="86400"

# Сколько дней хранить сырые события и отчёты. Очистка — раз в час пачками.
DIAGNOSTICS_RETENTION_DAYS="90"


# -----------------------------------------------------------------------------
# 7. Выгрузка данных для разбора (docs/28-diagnostics.md §6)
# -----------------------------------------------------------------------------

# Ключ HMAC-SHA256 для псевдонимов Telegram ID в выгрузке: hex от 64 знаков,
# openssl rand -hex 32. Секрет: выгрузка уходит в Telegram и во внешний сервис
# анализа. Смена ключа меняет все псевдонимы — выгрузки до и после неё не
# сопоставляются.
EXPORT_PSEUDONYM_KEY=""

# Кнопка и команда /export у администраторов. Требует EXPORT_PSEUDONYM_KEY,
# DATABASE_URL и чтения обновлений бота. Запасное значение настройки export.bot:
# при утечке токена бота её выключают в панели. Запасной путь без бота —
# pnpm closed-test:export.
DATA_EXPORT_BOT_ENABLED="false"


# -----------------------------------------------------------------------------
# 9. Авторизация игроков, приём забегов и оплата (docs/34-stage3-plan.md, WP1,
#    WP4, WP5)
#
# Вход включается ключом (docs/35-stage4-plan.md, Р53): задан секрет подписи —
# вход работает, пуст — эндпоинты отвечают 404. Со секретом нужны токен бота и
# база: без них вход не проверить и аккаунт негде хранить. Флага AUTH_ENABLED
# больше нет — строку из своего .env можно удалить.
# -----------------------------------------------------------------------------

# Секрет подписи токена доступа: hex от 64 знаков, openssl rand -hex 32.
# Секрет без значения по умолчанию — токен, подписанный известным секретом,
# это отсутствие авторизации. Смена секрета разлогинивает всех.
JWT_ACCESS_SECRET=""

# Сколько живёт токен доступа и токен продления. Токен доступа — минуты:
# украденный не должен работать до вечера, а клиент обновляет его молча.
AUTH_ACCESS_TTL_SEC="900"
AUTH_REFRESH_TTL_DAYS="30"

# Окно свежести подписи запуска для ВХОДА — не больше часа: на этой сессии
# работают деньги. Потолок зашит в схему конфигурации, поднять нельзя.
AUTH_INIT_DATA_MAX_AGE_SEC="3600"

# Сколько устройств помнит аккаунт; сверх лимита вытесняется самое старое.
AUTH_MAX_SESSIONS="10"

# Вход разработчика без Telegram — по имени "dev-<id>:Имя", без подписи.
# Заводит обычный аккаунт с ролью владельца: так команда проверяет рейтинг и
# профиль в браузере. Требует входа (JWT_ACCESS_SECRET); при NODE_ENV, отличном от
# development, бэкенд с "true" не стартует. Имя для входа dev-сервер берёт из
# VITE_AUTH_DEV_USER — "dev-<id>:Имя", например "dev-1:Разработчик"; в сборку
# клиента оно не попадает.
AUTH_DEV_LOGIN="false"
VITE_AUTH_DEV_USER=""


# Пороги антифрода забегов, фаза 1 (docs/34-stage3-plan.md, WP4, Р7). Здесь —
# нарочно мягкие умолчания, ловящие только невозможное: замер по 108 забегам
# ботов дал максимум 8,6 убийства в секунду и 4,6 уровня в минуту, умолчания —
# с пятикратным запасом. Боевые значения задаются в окружении прода и в
# репозиторий не попадают: опубликованный порог говорит читеру, сколько можно.
RUNS_MAX_KILLS_PER_SEC="40"
RUNS_MAX_LEVELS_PER_MIN="12"

# Отпечатки контента сборок, чьи забеги принимаются без вопросов, через
# запятую. Пусто — проверка выключена.
RUNS_KNOWN_CONTENT_HASHES=""

# Запас, секунды: заявленное время выживания сверх прошедшего по часам сервера.
RUNS_WALL_CLOCK_TOLERANCE_SEC="10"

# Насколько поздно может прийти сообщение о старте, чтобы ему ещё верить.
RUNS_START_MAX_DELAY_SEC="30"

# Оплата второго шанса за Telegram Stars (WP5) возможна при входе и чтении
# обновлений бота (TELEGRAM_BOT_UPDATES): оплату подтверждает обновление от
# Telegram, а на предварительную проверку бот обязан ответить за 10 секунд.
# Возможна — значит включена, пока её не выключили: переменная — запасное
# значение стоп-крана payments.stars в панели. В разработке оставьте "false"
# или включайте вместе с PAYMENTS_TEST_MODE: иначе звёзды настоящие.
PAYMENTS_ENABLED="false"

# Тестовая оплата (docs/34-stage3-plan.md, Р14): игрок видит настоящую цену,
# списывается одна звезда и тут же возвращается, продолжение засчитано. Только
# для разработки: при NODE_ENV, отличном от development, бэкенд с "true" не
# стартует.
PAYMENTS_TEST_MODE="false"

# Цена второго шанса: звёзд за каждую начатую минуту забега и потолок цены.
# Рабочие значения до решения геймдизайнера (docs/34-stage3-plan.md, О1).
CONTINUE_STARS_PER_MINUTE="1"
CONTINUE_MAX_STARS="30"


# -----------------------------------------------------------------------------
# 9.1 Курсы валют (docs/35-stage4-plan.md, §3.12, WP9)
#
# Опрос бесплатных источников курсов: ЦБ, ЕЦБ, ExchangeRate-API, CoinGecko,
# TON API, Binance. Выключен по умолчанию: включённый ходит в интернет раз в
# несколько минут. На машине разработчика включается, когда нужны курсы.
# Запасное значение настройки fx.polling: панель сильнее.
# -----------------------------------------------------------------------------

FX_ENABLED="false"

# Ключи CoinGecko — необязательные секреты. Пусто — запросы без ключа, с общим
# лимитом по адресу. Бесплатный демо-ключ даёт свой лимит — 10 000 запросов в
# месяц; платный — другой адрес и лимиты. Оба заданы — берётся платный.
# Тариф и частота опроса меняются сами, правка кода не нужна. Ключ, заданный
# в панели («Ключи интеграций»), сильнее этих строк.
FX_COINGECKO_DEMO_KEY=""
FX_COINGECKO_PRO_KEY=""


# -----------------------------------------------------------------------------
# 9.2 Ключи интеграций (docs/35-stage4-plan.md Р84, WP46)
#
# Токены внешних сервисов задаются в панели («Ключи интеграций») и лежат в
# базе только шифртекстом AES-256-GCM. Ключ шифрования — здесь: 32 случайных
# байта в base64, `openssl rand -base64 32`. Пусто — хранилище выключено, и
# ключи сервисов берутся только из окружения. Секрет, без значения по
# умолчанию, свой у каждого окружения; потерян — ключи из панели задают заново.
#
# Смена ключа шифрования: новый — в SECRETS_ENCRYPTION_KEY, прежний — в
# SECRETS_ENCRYPTION_KEY_PREVIOUS; когда все ключи в панели заданы заново,
# прежний убирают.
# -----------------------------------------------------------------------------

SECRETS_ENCRYPTION_KEY=""
SECRETS_ENCRYPTION_KEY_PREVIOUS=""


# -----------------------------------------------------------------------------
# 10. Клиентская сборка (всё ниже публичное и попадает в бандл)
# -----------------------------------------------------------------------------

# Адрес API для клиента. Пусто — тот же домен, что у приложения: dev-сервер
# проксирует /api сам.
VITE_API_URL=""

# Версия сборки в отчётах и событиях. В релизе подставляется из тега.
VITE_APP_VERSION="0.1.0"

# "1" — режим диагностики включён по умолчанию, пока игрок сам не тронул
# переключатель (docs/28-diagnostics.md §2.1). На закрытом тесте включён:
# тестеру не нужно искать настройку, чтобы в баг-репорте оказался seed.
VITE_DIAGNOSTICS_DEFAULT=""

# Предпросмотр для панели (docs/35-stage4-plan.md WP32): панель встраивает
# страницу клиента `preview/` и шлёт ей черновик. VITE_ADMIN_URL — адрес
# панели для сборки клиента: ей разрешено встроить клиент во фрейм, от неё
# страница принимает черновик. VITE_PREVIEW_URL — адрес страницы предпросмотра
# для сборки панели, например "https://tg.gonet.fun/preview/". На dev-сервере
# пустые значения — петля с портами ADMIN_PORT и WEB_TELEGRAM_PORT; в сборке
# пусто — предпросмотра нет (scripts/vite/preview-origins.ts).
VITE_ADMIN_URL=""
VITE_PREVIEW_URL=""

# "1" — инструменты команды (режим разработчика, стресс-тест, витрина
# компонентов, звуковая лаборатория) открыты без ответа сервера. Работает
# только на dev-сервере и нужно ровно для работы без бэкенда: через туннель к
# dev-серверу иначе их получает любой тестер. В сборке доступ решает сервер по
# ADMIN_TELEGRAM_IDS.
VITE_DEV_TOOLS=""


# -----------------------------------------------------------------------------
# 11. Тесты (docs/17-testing-strategy.md §4.2)
#
# Интеграционные тесты идут на настоящих Postgres и Redis. Без этих адресов они
# пропускаются локально; в CI их задают сервисы workflow.
# -----------------------------------------------------------------------------

TEST_DATABASE_URL=""
PLAYTEST_TEST_REDIS_URL=""
