{
  "name": "bullet-heaven-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "backend/api"
  ],
  "scripts": {
    "dev:telegram": "npm run dev -w apps/web-telegram",
    "dev:max": "npm run dev -w apps/web-max",
    "dev:vk": "npm run dev -w apps/web-vk",
    "dev:backend": "npm run start:dev -w backend/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "eslint": "^9.9.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0"
  }
}
