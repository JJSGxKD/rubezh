{
  "name": "bullet-heaven-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "tunnel": "frpc -c infra/frpc/frpc.local.toml",
    "dev:telegram": "pnpm --filter web-telegram dev",
    "dev:max": "pnpm --filter web-max dev",
    "dev:vk": "pnpm --filter web-vk dev",
    "dev:backend": "pnpm --filter backend-api start:dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc -b --pretty && tsc -p tsconfig.tests.json --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.9.0",
    "typescript": "^5.6.0",
    "vitest": "3.2.7"
  }
}
