{
  "name": "backend-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:dev": "node --watch --import @swc-node/register/esm-register src/main.ts",
    "dev": "node --watch --import @swc-node/register/esm-register src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "export": "node --import @swc-node/register/esm-register src/cli/closed-test-export.ts",
    "bot:webhook": "node --import @swc-node/register/esm-register src/cli/bot-webhook.ts",
    "runs:rebuild-leaderboard": "node --import @swc-node/register/esm-register src/cli/runs-rebuild-leaderboard.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-fastify": "12.0.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@resvg/resvg-js": "2.6.2",
    "bullmq": "6.3.6",
    "dotenv": "16.4.7",
    "fastify": "5.12.4",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.2",
    "@types/node": "22.20.2",
    "typescript": "5.9.3"
  }
}
